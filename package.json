{
  "name": "nexora-tms",
  "version": "0.0.0",
  "private": true,
  "description": "Nexora Transportation Management System",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "24.20.0",
    "pnpm": "11.23.0"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "validate": "pnpm check:toolchain && pnpm lint && pnpm typecheck && pnpm format:check",
    "infra:railway:plan": "railway config plan",
    "infra:railway:apply": "railway config apply",
    "prepare": "simple-git-hooks",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@railway/cli": "5.45.0",
    "@types/node": "24.13.2",
    "eslint": "10.9.1",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "railway": "3.11.0",
    "simple-git-hooks": "2.13.1",
    "turbo": "2.10.12",
    "typescript": "6.0.0",
    "typescript-eslint": "8.68.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "pre-push": "pnpm validate"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
