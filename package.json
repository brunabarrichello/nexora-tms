{
  "name": "nexora-tms",
  "version": "0.1.0",
  "private": true,
  "description": "Nexora Transportation Management System monorepo",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.20.0",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "bootstrap": "node scripts/bootstrap.mjs",
    "build": "turbo run build",
    "build:api": "pnpm --filter @nexora/api build",
    "build:web": "pnpm --filter @nexora/web build",
    "build:worker": "pnpm --filter @nexora/worker build",
    "check": "pnpm validate",
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm build:api && pnpm start:api",
    "dev:web": "pnpm --filter @nexora/web dev",
    "dev:worker": "pnpm build:worker && pnpm start:worker",
    "doctor": "node scripts/doctor.mjs",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --write apps/api/src/freight/freight-normalization.service.ts apps/api/src/freight/freight-normalization.validation.ts apps/api/src/freight/freight-normalization.validation.spec.ts && git diff -- apps/api/src/freight/freight-normalization.service.ts apps/api/src/freight/freight-normalization.validation.ts apps/api/src/freight/freight-normalization.validation.spec.ts && exit 1",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "lint:fix": "pnpm lint --fix",
    "neon:sql": "node scripts/neon/direct-sql.mjs",
    "prepare": "simple-git-hooks",
    "start:api": "pnpm --filter @nexora/api start",
    "start:web": "pnpm --filter @nexora/web start",
    "start:worker": "pnpm --filter @nexora/worker start",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "validate": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "eslint": "10.9.1",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "simple-git-hooks": "2.14.0",
    "turbo": "2.10.12",
    "typescript-eslint": "8.68.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,jsonc,yml,yaml,md,css,scss}": [
      "prettier --write"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "pnpm validate"
  }
}
