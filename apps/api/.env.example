# Nexora TMS API runtime
NODE_ENV=development
PORT=3001

# PostgreSQL runtime role (nexora_app)
DATABASE_URL=postgresql://nexora_app:<password>@<host>/neondb?sslmode=require
DATABASE_POOL_MAX=10
AUTH_DATABASE_POOL_MAX=4

# Managed IdP / OIDC
# Auth0 is the initial provider selected by ADR-0011.
OIDC_PROVIDER_KEY=auth0
# Keep the issuer exactly as advertised by Auth0, including the trailing slash.
OIDC_ISSUER_URL=https://<auth0-tenant>.<region>.auth0.com/
OIDC_JWKS_URL=https://<auth0-tenant>.<region>.auth0.com/.well-known/jwks.json
OIDC_AUDIENCE=<auth0-api-identifier>
OIDC_ALLOWED_ALGORITHMS=RS256
