# Local development only. Never commit real credentials.

NODE_ENV=development
NEXORA_ENV=development

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# API
API_HOST=0.0.0.0
API_PORT=3001

# Database placeholders — inject real values from the environment/secret manager.
DATABASE_URL=postgresql://APP_USER:APP_PASSWORD@HOST:5432/DB?sslmode=require
WORKER_DATABASE_URL=postgresql://WORKER_USER:WORKER_PASSWORD@HOST:5432/DB?sslmode=require
MIGRATIONS_DATABASE_URL=postgresql://MIGRATOR_USER:MIGRATOR_PASSWORD@HOST:5432/DB?sslmode=require
